public class MaxSubArray {
	public static int maxSum(int []arr, int k) {
	
		int i =0;
		int j =0;
		int sum = 0;
		int max = Integer.MIN_VALUE;
		
		while(j<arr.length) {
			sum  = sum + arr[j];
			if(j - i +1<k) {
				j++;
			}
			else if(j - i + 1==k) {
				max = Math.max(max, sum);
				sum = sum - arr[i];
				
				i++;
				j++;
			}
		}
		return max;
		
	}
	
//	First Negative Number in Every Window of Size K
