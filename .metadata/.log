	public static List<Integer> firstNegitive(int[]arr, int k){
		int i = 0;
		int j =0 ;
		
		List<Integer> result = new ArrayList<>();
		Queue<Integer> q = new LinkedList<>();
		while(j<arr.length) {
			if(arr[j]<0) q.add(arr[j]);
			
			if(j - i + 1<k) {
				
				j++;
			}else if(j - i + 1==k) {
				 if (q.isEmpty()) {
		                result.add(0);
		         }else {
		        	 
		            	result.add(q.peek());
		            }
				 if (!q.isEmpty() && arr[i] == q.peek()) {
		                q.poll();
		            }
		            i++;
					j++;
				
			}
			// Before sliding window, check if outgoing element is negative
           
		}
		return result;
		
	}
