package com.example.demo.co.service;

import java.util.function.Function;
import java.util.stream.Collectors;

public class PractiseService {

	public String create(String a, String b) {

		return a.concat(b).chars().mapToObj(p-> (char) p).collect(Collectors.groupingBy(Function.identity(), Collectors.counting())).toString();
		 
	}

}
