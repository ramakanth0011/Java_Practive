package string;

public class RomantoInteger13 {
	 public int romanToInt(String s){
		 int result = 0;
		 for(int i=1; i<=s.length()-1; i++) {
			 char prev = s.charAt(i-1);
			 char curr = s.charAt(i);
			 if(prev>curr) {
				result = curr - prev;
			 }
			 if(charAt=='I') {
				 result = result + 1;
			 }else if(charAt=='V') {
				 result = result + 5;
			 }
			 else if(charAt=='X') {
				 result = result + 10;
			 }
			 else if(charAt=='L') {
				 result = result + 50;
			 }
			 else if(charAt=='C') {
