package interview;

import java.util.ArrayList;
import java.util.List;
import java.util.stream.Collectors;

public class Test {
	final static int  x = 10;
	
	    public static void main(String[] args) {
	        System.out.println(m1());
	        System.out.println(x);
	        
	        List<Employee> employees = List.of(
				    new Employee("Ravi", 1, 60000, "IT", "Amit"),
				    new Employee("Ankit", 2, 75000, "IT", "Amit"),
				    new Employee("Neha", 3, 50000, "HR", "Suman"),
				    new Employee("Priya", 4, 65000, "HR", "Suman"),
				    new Employee("Rahul", 5, 80000, "Finance", "Karan"),
				    new Employee("Suman", 6, 90000, "Finance", "Karan")
				);
			

	        employees.stream().collect(Collectors.groupingBy(Employee::department, Collectors.mapping(Employee::name, Collectors.toList()))).entrySet().forEach(System.out::println);
	        
	        employees.stream().collect(Collectors.groupingBy(Employee::department)).entrySet()
	        .stream().filter(f->f.getValue()==1).forEach(System.out::println);
	    }
	    
		static int m1() {
	        int x = 20;      // class-level or initial value
	        try {
	            x = 30;      // value set in try
	            return x;    // return is "staged" but not yet executed
	        } finally {
	            x = 40;      // finally runs BEFORE the return completes
	            // no return here
	        }
	    }
		
		
		
		
	

}
